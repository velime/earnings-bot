# Normalize line endings: LF in the repo for everything, CRLF only for Windows scripts.
* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile      text eol=lf
*.service       text eol=lf
*.spec          text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.db  binary
