# ---------------------------------------------------------------- Telegram
# The bot posts into a CHANNEL. Add the bot to the channel as an administrator
# with "Post messages" permission, then set the channel here:
#   public channel  -> @channelusername
#   private channel -> numeric id like -1001234567890
TELEGRAM_TOKEN=123456:ABC-DEF-your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=@your_channel
# optional: send-failure notifications go here (your personal chat id)
TELEGRAM_ADMIN_CHAT_ID=

# ---------------------------------------------------------------- Calendars
# Primary. Empty -> primary calendar is skipped.
FINNHUB_TOKEN=
# Fallback, used automatically when Finnhub returns nothing.
FMP_API_KEY=

# ---------------------------------------------------------------- Exchanges
# Which venues to show, in the order the lines should appear in the message.
# MEXC always defines the tradable-ticker universe (it lists <TICKER>STOCK_USDT);
# the others only add a line when they also list that ticker.
EXCHANGES=mexc,bitget,gate
# Referral / share codes appended to each venue link (leave blank for none).
MEXC_SHARE_CODE=
BITGET_REF_CODE=
GATE_REF_CODE=
# A venue is shown only if its CURRENT leverage is >= this. An earnings report
# with no venue at/above the threshold is ignored completely (no alert, no queue).
MIN_LEVERAGE=50

# ---------------------------------------------------------------- Pinned queue
# On start the bot posts a "queue for the next CALENDAR_DAYS_AHEAD days" message
# into the channel and pins it; it is edited on every sync and after every alert
# (the alerted ticker drops off). Needs the "Pin messages" admin right.
PIN_QUEUE=true

# ---------------------------------------------------------------- Behaviour
ALERT_LEAD_MINUTES=10
SYNC_INTERVAL_SECONDS=1800
SEND_INTERVAL_SECONDS=20
CALENDAR_DAYS_AHEAD=3
STALE_ALERT_MINUTES=20

# ---------------------------------------------------------------- Storage / display
DB_PATH=data/earnings.db
TZ_DISPLAY=Europe/Moscow
TZ_MARKET=America/New_York
HTTP_TIMEOUT=15
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Footer (HTML)
# Appended after a 14x "━" divider. Leave empty for no footer at all.
# Example: <a href="https://t.me/your_channel">Календарь отчётов</a>
FOOTER_HTML=
