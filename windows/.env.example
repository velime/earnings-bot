# Windows build config. build.ps1 copies this to windows\.env on first run.
# Paths are relative to the windows\ folder (that is the working directory).

# ---------------------------------------------------------------- Telegram
# Add the bot to the channel as an administrator with "Post messages".
#   public channel  -> @channelusername
#   private channel -> -1001234567890
TELEGRAM_TOKEN=123456:ABC-DEF-your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=@your_channel
TELEGRAM_ADMIN_CHAT_ID=

# ---------------------------------------------------------------- Calendars
FINNHUB_TOKEN=
FMP_API_KEY=

# ---------------------------------------------------------------- Exchanges
EXCHANGES=mexc,bitget,gate
MEXC_SHARE_CODE=
BITGET_REF_CODE=
GATE_REF_CODE=
# venue shown only if current leverage >= this; report with no such venue is ignored
MIN_LEVERAGE=50
# post + pin a "queue for the next N days" message on start, edit it as things change
PIN_QUEUE=true

# ---------------------------------------------------------------- Behaviour
ALERT_LEAD_MINUTES=10
SYNC_INTERVAL_SECONDS=1800
SEND_INTERVAL_SECONDS=20
CALENDAR_DAYS_AHEAD=3
STALE_ALERT_MINUTES=20

# ---------------------------------------------------------------- Storage / display
DB_PATH=data\earnings.db
TZ_DISPLAY=Europe/Moscow
TZ_MARKET=America/New_York
HTTP_TIMEOUT=15
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Footer (HTML)
# Empty = no footer. Example: <a href="https://t.me/your_channel">Календарь отчётов</a>
FOOTER_HTML=
